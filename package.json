{
  "name": "tickrlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "author": "Chanukya Gattu",
  "description": "Market signals computed in the browser, published from CI, and measured in public.",
  "homepage": "https://chanukyagattu.github.io/tickrlab/",
  "repository": {
    "type": "git",
    "url": "https://github.com/chanukyagattu/tickrlab.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:prices": "node scripts/fetch-prices.mjs --out dist-data",
    "fetch:news": "node scripts/fetch-news.mjs --out dist-data"
  },
  "dependencies": {
    "lightweight-charts": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
